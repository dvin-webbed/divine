NODE_ENV=development
PORT=4000

# JWT signing secret - change to a long random string
JWT_SECRET=change-this-to-something-long-and-random

# MySQL connection - matches docker-compose.yml (dev) by default
DB_HOST=localhost
DB_PORT=3306
DB_USER=bluepips
DB_PASSWORD=bluepips_dev_password
DB_NAME=bluepips
# Only needed for docker-compose.prod.yml (sets the MySQL root password)
DB_ROOT_PASSWORD=change-this-root-password

# Site monitoring
ADMIN_KEY=change-this-too
IP_SALT=change-this-salt-value

# Registration verification (Brevo transactional email API)
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Blue Pips

# Arbitrage bot ingestion (leave empty to disable the endpoint)
ARBITRAGE_INGEST_KEY=

# Optional ethers v6 DeFi event watcher. It stays disabled until configured.
DEFI_RPC_URL=
DEFI_CONTRACT_ADDRESS=
DEFI_START_BLOCK=
DEFI_YIELD_EVENT_ABI=event YieldGenerated(uint256 grossYield)
DEFI_YIELD_EVENT_NAME=YieldGenerated
DEFI_YIELD_EVENT_FIELD=grossYield
DEFI_YIELD_TOKEN_DECIMALS=6
DEFI_YIELD_TOKEN_USD_PRICE=
DEFI_GAS_TOKEN_USD_PRICE=
DEFI_CONFIRMATIONS=3
DEFI_MAX_BLOCK_RANGE=2000
YIELD_POLL_INTERVAL_MS=30000
PAYOUT_WORKER_INTERVAL_MS=30000

# CORS - the browser origin allowed to call this API.
# Use * only in local development. In production, set this to your real domain,
# e.g. https://www.bluepips.example
ALLOWED_ORIGIN=*

# ---- Payment providers (optional) ----
# Leave both unset to run entirely in sandbox/mock mode - deposits and
# withdrawals will work end-to-end but no real money moves. See README
# "Payments & funding" for the free-sandbox path to real providers.
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox
# COINBASE_COMMERCE_API_KEY=

# Bank names are searched live through Plaid Institutions. The directory covers
# only provider-supported countries and requires Plaid credentials above.
# Receiving address for USDT deposits on TRON (TRC20). Leave unset to disable deposits.
# CRYPTO_WALLET_USDT_TRC20=
# STRIPE_SECRET_KEY=
